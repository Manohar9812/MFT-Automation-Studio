# MFT Automation Studio — backend environment template.
# Copy this file to  backend/.env  and fill in the real values.
# The real .env is git-ignored and must never be committed.

# ---- Azure OpenAI (chat) — used by the LangGraph/LangChain agent ----
API_OPENAI_API_KEY=
API_OPENAI_ENDPOINT=
API_OPENAI_DEPLOYMENT=gpt-4o-mini
API_OPENAI_VERSION=2025-01-01-preview

# ---- Azure AI Search (optional RAG backend) ----
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=mft-templates

# ---- LangSmith tracing (optional) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mft-automation-studio

# ---- Server ----
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
